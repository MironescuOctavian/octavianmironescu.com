{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octavianmironescu-dot-com",
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-08-27",
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "octavianmironescu.com",
      "custom_domain": true
    },
    {
      "pattern": "www.octavianmironescu.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CONSTRUCTION_MODE": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "octavianmironescu-dot-com",
      "remote": true
    }
  ]
}

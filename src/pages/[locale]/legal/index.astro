---

import { getCollection } from 'astro:content';
import AppLayout from '#layouts/AppLayout.astro';
import FormattedDate from "#components/FormattedDate.astro";
import { getLocale, getRelativeLocaleUrl } from "@rimelight/i18n";

const activeLocale = Astro.params["locale"] || getLocale();
const legalPolicies = (await getCollection('legal')).filter((policy) =>
  policy.id.startsWith(`${activeLocale}/`)
);

---

<AppLayout>
    <main>
        <section>
            <ul>
                {
                    legalPolicies.map((policy) => {
                        const slug = policy.id.replace(new RegExp(`^${activeLocale}/`), '');
                        return (
                            <li>
                                <a href={getRelativeLocaleUrl(`/legal/${slug}/`)}>
                                    <h4 class="title">{policy.data.title}</h4>
                                </a>
                                <p class="date">
                                    <FormattedDate date={policy.data.pubDate} />
                                </p>
                            </li>
                        );
                    })
                }
            </ul>
        </section>
    </main>



</AppLayout>

---
import { getEntry, render } from 'astro:content';
import AppLayout from '#layouts/AppLayout.astro';
import FormattedDate from '#components/FormattedDate.astro';

const { locale, slug } = Astro.params;
const page = await getEntry('legal', `${locale}/${slug}`);

if (!page) {
    return Astro.rewrite('/404');
}

const { Content } = await render(page);
---

<AppLayout title={page.data.title} description={page.data.description}>
    <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
        <header class="border-b border-neutral-200 pb-6 mb-8 text-center">
            <h1 class="text-3xl sm:text-4xl font-bold mb-2">{page.data.title}</h1>
            {page.data.pubDate && (
                <p class="text-sm text-neutral-500">
                    <FormattedDate date={page.data.pubDate} />
                </p>
            )}
        </header>
        <article class="prose max-w-none leading-relaxed">
            <Content />
        </article>
    </div>
</AppLayout>
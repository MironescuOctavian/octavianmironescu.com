---
import AppLayout from "#layouts/AppLayout.astro"

Astro.response.status = 401
Astro.response.statusText = "Unauthorized"
---

<AppLayout title="401 - Unauthorized" description="Authentication is required to access this page.">
    <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24 text-center">
        <h1 class="text-4xl sm:text-6xl font-extrabold mb-4">401</h1>
        <p class="text-lg text-neutral-500 mb-8">
            Authentication is required to access this page.
        </p>
        <a href="/" class="text-primary hover:underline font-medium">Return to Home</a>
    </div>
</AppLayout>

---
import AppLayout from "#layouts/AppLayout.astro";
import AppError from "#components/app/AppError.astro";

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<AppLayout title="404 - Not Found" description="Page not found">
	<AppError
		code={404}
		title="Page Not Found"
		description="Page has not been found."
		actions={[
			{ label: "Go to Home Page", href: "/", variant: "solid", color: "primary", icon: "i-lucide-home" }
		]}
	/>
</AppLayout>
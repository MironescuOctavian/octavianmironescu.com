---
import AppLayout from "#layouts/AppLayout.astro"
---

<AppLayout title="404 - Not Found" description="Page not found">
    <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24 text-center">
        <h1 class="text-4xl sm:text-6xl font-extrabold mb-4">404</h1>
        <p class="text-lg text-neutral-500 mb-8">
            Page has not been found.
        </p>
        <a href="/" class="text-primary hover:underline font-medium">Return to Home</a>
    </div>
</AppLayout>
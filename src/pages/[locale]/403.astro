---
import AppLayout from "#layouts/AppLayout.astro";
import AppError from "#components/app/AppError.astro";

Astro.response.status = 403;
Astro.response.statusText = "Forbidden";
---

<AppLayout title="403 - Forbidden" description="You do not have permission to access this resource.">
	<AppError
		code={403}
		title="Access Denied"
		description="You do not have permission to access this resource."
		actions={[
			{ label: "Go to Home Page", href: "/", variant: "solid", color: "primary", icon: "i-lucide-home" }
		]}
	/>
</AppLayout>

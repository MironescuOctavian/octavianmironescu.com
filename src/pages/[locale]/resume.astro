---
import AppLayout from '#layouts/AppLayout.astro';

interface SocialLink {
  icon: string;
  href: string;
  ariaLabel: string;
}

const socialLinks: SocialLink[] = [
  {
    icon: "i-mdi-linkedin",
    href: "https://www.linkedin.com/in/octavian-mironescu-a605b921a/",
    ariaLabel: "LinkedIn"
  },
  {
    icon: "i-mdi-github",
    href: "https://github.com/MironescuOctavian",
    ariaLabel: "GitHub"
  }
]

interface AboutMe {
  label: string;
  value: string;
  icon1?: string;
  icon2?: string;
  href?: string;
}

const age = (d => d.getFullYear() - 1999 - (d.getMonth() < 7 || (d.getMonth() === 7 && d.getDate() < 10) ? 1 : 0))(new Date());
const aboutMeDetails: AboutMe[] = [
  {
    label: "Gender",
    value: "Male"
  },
  {
    label: "Pronouns",
    value: "He/Him"
  },
  {
    label: "Nationality",
    value: "Romanian"
  },
  {
    label: "Age",
    value: `${age}`
  },
  {
    label: "Location",
    icon1: "i-mdi-google-maps",
    value: "Bucharest, Romania",
    icon2: "i-mdi:launch",
    href: "https://en.wikipedia.org/wiki/Bucharest"
  }
]
interface languages {
  label: string;
  value: string;
  icon1?: string;
  icon2?: string;
  href?: string;
}

const languagesSpoken: languages[] = [
  {
    label: "English",
    value: "Fluent"
  },
  {
    label: "Romanian",
    value: "Fluent"
  },
  {
    label: "German",
    value: "Basic"
  }
]
---
<AppLayout>
  <div class="flex flex-col md:flex-row gap-xl">

    <!-- Page Body -->
    <div class="flex flex-col gap-6 px-xl py-24">

      <!-- Hero Section -->
      <section>
      <header class="flex flex-col items-center gap-4">
        <div class="flex flex-col gap-2 items-center">
          <h1 class="text-6xl font-bold">Hey! I'm Octavian Mironescu</h1>
          <h2 class="text-2xl text-gray">I'm a Java & Web Software Developer.</h2>
        </div>
        <div class="flex flex-row justify-center items-center gap-8">
          <a class="text-3xl" href="/contact/">
            <p class="text-2xl font-bold bg-green-600 rounded-md p-2">Hire me</p>
          </a>
          <a class="i-mdi-github text-4xl" href="https://github.com/MironescuOctavian"/>
        </div>
      </header>
    </section>

      <!-- Skill Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Skills</h2>
          <hr class="border-t w-full" />
        </header>

        <div class="flex flex-row gap-4">

          <!-- Java Dev Cards -->
            <div class="flex flex-col gap-4 text-gray">
              <div class="flex flex-row gap-4">
                <span class="i-mdi-coffee text-2xl text-green-600"/>
                <h3 class="text-md font-bold uppercase tracking-wider text-white">Java Software Developer</h3>
              </div>
              <p class="text-sm"> Designing, building, and maintaining enterprise-level applications and backend services using the Java programming language and its vast ecosystem. </p>
            </div>

          <!-- Web Dev Cards -->
            <div class="flex flex-col gap-4 text-gray">
              <div class="flex flex-row gap-4">
                <span class="i-mdi-application-brackets-outline text-2xl text-green-600" />
                <h3 class="text-md font-bold uppercase tracking-wider text-white">Web Software Developer</h3>
              </div>
              <p class="text-sm"> Building fast, responsive, and secure web applications using modern standard architectures, framework integration, and performance optimization techniques. </p>
            </div>

          <!-- Design Cards -->
            <div class="flex flex-col gap-4 text-gray">
              <div class="flex flex-row gap-4">
                <span class="i-mdi:palette text-2xl text-green-600" />
                <h3 class="text-md font-bold uppercase tracking-wider text-white">Design Philosophies</h3>
              </div>
              <p class="text-sm"> Focusing on accessible user experiences, interface detail, smooth interactive feedback loops, and visually consistent modular systems.</p>
            </div>

        </div>
      </section>

      <!-- Technologies & Tools Section -->
      <section class="flex flex-col gap-4">
        <h2 class="text-3xl font-bold text-white tracking-tight">Technologies & Tools</h2>
        <hr class="border-t w-full" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

          <!-- LANGUAGES & FRAMEWORKS -->
          <div class="flex flex-col gap-4">
            <h3 class="text-md font-bold uppercase tracking-wider text-white">LANGUAGES & FRAMEWORKS</h3>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-java text-base shrink-0" />
                <span class="text-sm">Java</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-spring-icon text-base shrink-0" />
                <span class="text-sm">Spring Boot</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-typescript-icon text-base shrink-0" />
                <span class="text-sm">TypeScript</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-vue text-base shrink-0" />
                <span class="text-sm">Vue</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-solidjs-icon text-base shrink-0" />
                <span class="text-sm">SolidJS</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-unocss text-base shrink-0" />
                <span class="text-sm">UnoCSS</span>
              </li>
            </ul>
          </div>

          <!-- DEVELOPMENT ENVIRONMENT -->
          <div class="flex flex-col gap-4">
            <h3 class="text-md font-bold uppercase tracking-wider text-white">DEVELOPMENT ENVIRONMENT</h3>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-intellij-idea text-base shrink-0" />
                <span class="text-sm">IntelliJ</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-visual-studio-code text-base shrink-0" />
                <span class="text-sm">Visual Studio</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-webstorm text-base shrink-0" />
                <span class="text-sm">WebStorm</span>
              </li>
            </ul>
          </div>

          <!-- BUILD & PACKAGE -->
          <div class="flex flex-col gap-4">
            <h3 class="text-md font-bold uppercase tracking-wider text-white">BUILD & PACKAGE</h3>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-gradle text-base shrink-0" />
                <span class="text-sm">Gradle</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-vitejs text-base shrink-0" />
                <span class="text-sm">Vite-plus</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-pnpm text-base shrink-0" />
                <span class="text-sm">pnpm</span>
              </li>
            </ul>
          </div>

          <!-- DEPLOYMENT -->
          <div class="flex flex-col gap-4">
            <h3 class="text-md font-bold uppercase tracking-wider text-white">DEPLOYMENT</h3>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-docker-icon text-base shrink-0" />
                <span class="text-sm">Docker</span>
              </li>
              <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                <span class="i-logos-cloudflare-icon text-base shrink-0" />
                <span class="text-sm">Cloudflare</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Experience Section -->
      <section class="flex flex-col gap-6">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Experience</h2>
          <hr class="border-t w-full" />
        </header>

        <!-- Job 1 -->
        <div class="text-sm">
          <span class="text-gray">June 2022 - November 2022</span>
          <h3 class="font-bold text-md">Junior Progammer @ Property Pass</h3>
          <span class="text-gray">Utrecht, Netherlands - Remote</span>
          <ul class="flex flex-row items-center gap-2 p-x-2 ">
            <li class="bg-green-900 text-green-400 p-1 rounded">Kotlin</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">Java</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">Spring Boot</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">MongoDB</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">GraphQL</li>
          </ul>
          <h4 class="font-bold text-gray">Summary:</h4>
          <p class="text-gray"> Developed, built and maintained the application behind the company's website that handled real estate passports for commercial real estate owners.</p>
          <h4 class="font-bold text-gray">Responsibilities:</h4>
          <ul class="flex flex-col px-6 gap-2 list-disc">
            <li class="text-sm text-gray">Development of a spring-boot based Application written in Kotlin related to real estate commerce.</li>
            <li class="text-sm text-gray">Creating and managing data in a MongoDB cluster.</li>
            <li class="text-sm text-gray">Writing aggregation pipelines for MongoDB data for analytics breakdowns for stakeholders.</li>
            <li class="text-sm text-gray">Refactoring project documentation</li>
          </ul>

        </div>

        <!-- Job 2 -->
        <div class="text-sm">
          <span class="text-gray">May 2023 - January 2024</span>
          <h3 class="font-bold text-md">Junior Progammer @ CoruScript</h3>
          <span class="text-gray">Bucharest, Romania - On-site/Remote</span>
          <ul class="flex flex-row items-center gap-2 p-x-2 ">
            <li class="bg-green-900 text-green-400 p-1 rounded">Java</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">Spring Boot</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">Amazon Web Services</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">PostgreSQL</li>
          </ul>
          <h4 class="font-bold text-gray">Summary:</h4>
          <p class="text-gray"> Developed the backend part of the website of a platform that offers services for building applications based on the clients needs.</p>
          <h4 class="font-bold text-gray">Responsibilities:</h4>
          <ul class="flex flex-col px-6 gap-2 list-disc">
            <li class="text-sm text-gray">Developed, tested and maintained the company's website application built with Java and Spring.</li>
            <li class="text-sm text-gray">Maintained and wrote pipelines for the cloud architecture using AWB.</li>
          </ul>

        </div>

        <!-- Job 3 -->
        <div class="text-sm">
          <span class="text-gray">February 2024 - Present</span>
          <h3 class="font-bold text-md">Freelancing</h3>
          <span class="text-gray">Bucharest, Romania - On-site/Remote</span>
          <h4 class="font-bold text-gray">Summary:</h4>
          <p class="text-gray  ">Wrote, tested, and maintained software, websites for various clients on a contract basis.</p>

        </div>
      </section>

      <!-- Education Section -->
      <section class="flex flex-col gap-4">
      <header class="flex flex-col gap-4">
        <h2 class="text-3xl font-bold text-white tracking-tight">Education</h2>
        <hr class="border-t w-full" />
      </header>

        <!-- Masters Degree-->
        <div class="flex flex-col text-gray text-sm">
          <span>2021 - 2023</span>
          <h3 class="font-bold text-md">Masters Degree in Computer Science</h3>
          <span>OVID - Universitea Ovidius Constanta</span>
        </div>

        <!-- Bachelors Degree-->
        <div class="flex flex-col text-gray text-sm">
          <span>2018 - 2021</span>
          <h3 class="font-bold text-md">Bachelors Degree in Computer Science</h3>
          <span>OVID - Universitea Ovidius Constanta</span>
        </div>
      </section>

      <!-- Projects Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Projects</h2>
          <hr class="border-t w-full" />
        </header>

        <!-- Discord Bot Project -->
        <div class="flex flex-col text-gray text-sm">
          <h3 class="text-md font-bold text-white">Discord Automation Bot</h3>
          <span>2024 - Developer & Maintainer</span>
          <ul class="flex flex-row items-center gap-2 p-x-2 ">
            <li class="bg-green-900 text-green-400 p-1 rounded">Java</li>
            <li class="bg-green-900 text-green-400 p-1 rounded">Discord Developer Portal</li>
          </ul>

        </div>
      </section>

      <!-- Certifications Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Certifications</h2>
          <hr class="border-t w-full" />
        </header>

      </section>
    </div>

    <!-- Left Sidebar -->
    <aside aria-label="Sidebar" class="flex flex-col gap-6 px-xl py-24 order-first md:border-r border-green-900">

      <!-- Intro Section -->
      <section aria-labelledby="resume-sidebar-name" class="flex flex-col items-center gap-4">

        <!-- Name & Profession -->
        <header class="flex flex-col gap-4 items-center">
          <img class="h-auto w-65 border border-4 border-green-900" src="https://cdn.octavianmironescu.com/images/image0.jpg" alt="Graduation Pic"/>
          <div class="flex flex-col text-center">
            <h2 id="resume-sidebar-name" class="text-3xl font-bold">Mironescu Octavian</h2>
            <span class="text-lg text-gray"> Software Developer </span>
          </div>
        </header>

        <!--Links for working-->
        <ul class="flex justify-center gap-4">
          {socialLinks.map((socialLink) => (
            <li aria-label={socialLink.ariaLabel}>
              <a href={socialLink.href} class="flex items-center justify-center">
                <span class:list={['text-2xl', socialLink.icon]}/>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- About Me Section -->
      <section aria-labelledby="resume-sidebar-about-me" class="flex flex-col gap-xs">
        <header class="flex flex-col gap-2">
          <div class="flex flex-row gap-2 items-center">
            <span class="i-mdi-account text-base"/>
            <h2 id="resume-sidebar-about-me" class="font-bold text-sm">ABOUT ME</h2>
          </div>
          <hr/>
        </header>

        <dl class="flex flex-col gap-2 text-sm">
          {aboutMeDetails.map((aboutMe) => (
            <>
              <div class="flex flex-row justify-between items-center gap-2">
                <dt class="font-bold">{aboutMe.label}</dt>
                <dd class="text-gray flex flex-row items-center gap-1.5">
                  <a href={aboutMe.href} class="flex items-center justify-center">
                    {aboutMe.icon1 && <span class={aboutMe.icon1}/>}
                    <span>{aboutMe.value}</span>
                    {aboutMe.icon2 && <span class={aboutMe.icon2}/>}
                  </a>
                </dd>
              </div>
              <hr/>
            </>
          ))}
        </dl>
      </section>

      <!-- LANAGUAGES SECTION -->
      <section aria-labelledby="resume-sidebar-languages" class = "flex flex-col gap-xs">
        <header class="flex flex-col gap-2">
          <div class="flex flex-row gap-2 items-center">
            <span class="text-gray i-mdi-translate text-base"/>
            <h4 id="resume-sidebar-languages" class="font-bold text-sm">LANGUAGES</h4>
          </div>
          <hr />
        </header>
            <dl class="flex flex-col gap-2 text-sm">
              {languagesSpoken.map((language) => (
              <div class="flex flex-row gap-2 justify-between">
                <dt class="font-bold">{language.label}</dt>
                <dd class="text-gray">{language.value}</dd>
              </div>
              <hr/>
              ))}
            </dl>
      </section>
    </aside>

  </div>
</AppLayout>

---
import "virtual:uno.css";
---
<div class ="flex flex-row">
  <!-- LEFT SECTION -->
  <div class ="flex flex-col gap-6 px-xl py-24">
    <!-- INTRO SECTION -->
    <div class="flex flex-col gap-xs">
      <div class="flex justify-center">
        <img src="https://placehold.co/128x128" alt="Placeholder Image"/>
      </div>
      <div class="flex flex-col">
        <div class="flex justify-center">
          <h3 class="text-3xl font-bold">Mironescu Octavian</h3>
        </div>
        <div class="flex justify-center">
          <span class="text-lg text-gray">Software Developer</span>
      </div>
      </div>
      <div class="flex justify-center">
        <a href="https://google.com" class=" text-green"> AVAILABLE FOR HIRE</a>
      </div>
      <div class="flex justify-center gap-4">
        <a href="https://www.linkedin.com/in/octavian-mironescu-a605b921a/">LinkedIn</a>
        <a href="https://github.com/MironescuOctavian">Github</a>
      </div>
    </div>
      <!-- ABOUT ME SECTION -->
    <div class = "flex flex-col gap-xs">
      <div class="flex flex-row gap-2">
        <span class="text-gray">Icon</span>
        <h4 class="text-gray">ABOUT ME</h4>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Gender</span>
        <span >Male</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Pronouns</span>
        <span>He / Him</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Nationality</span>
        <span>Romanian</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Age</span>
        <span>27</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Location</span>
        <a href="https://en.wikipedia.org/wiki/Bucharest" class="flex flex-row gap-2">
        <span>Icon</span>
        <span>Bucharest,Romania</span>
        <span>Icon</span>
        </a>
      </div>

    </div>
    <!-- LANAGUAGES SECTION -->
    <div class = "flex flex-col gap-xs">
      <div class="flex flex-row gap-2">
        <span class="text-gray">Icon</span>
        <h4 class="text-gray">LANGUAGES</h4>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">Romanian</span>
        <span >Fluent</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">English</span>
        <span >Fluent</span>
      </div>

      <hr />

      <div class="flex flex-row justify-between">
        <span class="text-gray">German</span>
        <span >Basic</span>
      </div>
    </div>
  </div>

  <div>
    RIGHT
    <div>
      VERY BIG TEXT
    </div>
  </div>
</div>

---
import AppLayout from '#layouts/AppLayout.astro';

interface SocialLink {
  icon: string;
  href: string;
  ariaLabel: string;
}

const socialLinks: SocialLink[] = [
  {
    icon: "i-mdi-linkedin",
    href: "https://www.linkedin.com/in/octavian-mironescu-a605b921a/",
    ariaLabel: "LinkedIn"
  },
  {
    icon: "i-mdi-github",
    href: "https://github.com/MironescuOctavian",
    ariaLabel: "GitHub"
  }
]

interface AboutMe {
  label: string;
  value: string;
  icon1?: string;
  icon2?: string;
  href?: string;
}

const age = (d => d.getFullYear() - 1999 - (d.getMonth() < 7 || (d.getMonth() === 7 && d.getDate() < 10) ? 1 : 0))(new Date());
const aboutMeDetails: AboutMe[] = [
  {
    label: "Gender",
    value: "Male"
  },
  {
    label: "Pronouns",
    value: "He/Him"
  },
  {
    label: "Nationality",
    value: "Romanian"
  },
  {
    label: "Age",
    value: `${age}`
  },
  {
    label: "Location",
    icon1: "i-mdi-google-maps",
    value: "Bucharest, Romania",
    icon2: "i-mdi:launch",
    href: "https://en.wikipedia.org/wiki/Bucharest"
  }
]
interface languages {
  label: string;
  value: string;
  icon1?: string;
  icon2?: string;
  href?: string;
}

const languagesSpoken: languages[] = [
  {
    label: "English",
    value: "Fluent"
  },
  {
    label: "Romanian",
    value: "Fluent"
  },
  {
    label: "German",
    value: "Basic"
  }
]

interface Skill {
  title: string;
  icon: string;
  description: string;
}

const skills: Skill[] = [
  {
    title: "Java Software Developer",
    icon: "i-mdi-coffee",
    description: "Designing, building, and maintaining enterprise-level applications and backend services using the Java programming language and its vast ecosystem."
  },
  {
    title: "Web Software Developer",
    icon: "i-mdi-application-brackets-outline",
    description: "Building fast, responsive, and secure web applications using modern standard architectures, framework integration, and performance optimization techniques."
  },
  {
    title: "Design Philosophies",
    icon: "i-mdi:palette",
    description: "Focusing on accessible user experiences, interface detail, smooth interactive feedback loops, and visually consistent modular systems."
  }
]

interface TechItem {
  name: string;
  icon: string;
}

interface TechCategory {
  title: string;
  items: TechItem[];
}

const techCategories: TechCategory[] = [
  {
    title: "LANGUAGES & FRAMEWORKS",
    items: [
      { name: "Java", icon: "i-logos-java" },
      { name: "Spring Boot", icon: "i-logos-spring-icon" },
      { name: "TypeScript", icon: "i-logos-typescript-icon" },
      { name: "Vue", icon: "i-logos-vue" },
      { name: "SolidJS", icon: "i-logos-solidjs-icon" },
      { name: "UnoCSS", icon: "i-logos-unocss" }
    ]
  },
  {
    title: "DEVELOPMENT ENVIRONMENT",
    items: [
      { name: "IntelliJ", icon: "i-logos-intellij-idea" },
      { name: "Visual Studio", icon: "i-logos-visual-studio-code" },
      { name: "WebStorm", icon: "i-logos-webstorm" }
    ]
  },
  {
    title: "BUILD & PACKAGE",
    items: [
      { name: "Gradle", icon: "i-logos-gradle" },
      { name: "Vite-plus", icon: "i-logos-vitejs" },
      { name: "pnpm", icon: "i-logos-pnpm" }
    ]
  },
  {
    title: "DEPLOYMENT",
    items: [
      { name: "Docker", icon: "i-logos-docker-icon" },
      { name: "Cloudflare", icon: "i-logos-cloudflare-icon" }
    ]
  }
]

interface Experience {
  period: string;
  role: string;
  location?: string;
  tags?: string[];
  summary: string;
  responsibilities?: string[];
}

const experiences: Experience[] = [
  {
    period: "June 2022 - November 2022",
    role: "Junior Progammer @ Property Pass",
    location: "Utrecht, Netherlands - Remote",
    tags: ["Kotlin", "Java", "Spring Boot", "MongoDB", "GraphQL"],
    summary: "Developed, built and maintained the application behind the company's website that handled real estate passports for commercial real estate owners.",
    responsibilities: [
      "Development of a spring-boot based Application written in Kotlin related to real estate commerce.",
      "Creating and managing data in a MongoDB cluster.",
      "Writing aggregation pipelines for MongoDB data for analytics breakdowns for stakeholders.",
      "Refactoring project documentation"
    ]
  },
  {
    period: "May 2023 - January 2024",
    role: "Junior Progammer @ CoruScript",
    location: "Bucharest, Romania - On-site/Remote",
    tags: ["Java", "Spring Boot", "Amazon Web Services", "PostgreSQL"],
    summary: "Developed the backend part of the website of a platform that offers services for building applications based on the clients needs.",
    responsibilities: [
      "Developed, tested and maintained the company's website application built with Java and Spring.",
      "Maintained and wrote pipelines for the cloud architecture using AWB."
    ]
  },
  {
    period: "February 2024 - Present",
    role: "Freelancing",
    location: "Bucharest, Romania - On-site/Remote",
    summary: "Wrote, tested, and maintained software, websites for various clients on a contract basis."
  }
]

interface Education {
  period: string;
  degree: string;
  institution: string;
}

const educationList: Education[] = [
  {
    period: "2021 - 2023",
    degree: "Masters Degree in Computer Science",
    institution: "OVID - Universitea Ovidius Constanta"
  },
  {
    period: "2018 - 2021",
    degree: "Bachelors Degree in Computer Science",
    institution: "OVID - Universitea Ovidius Constanta"
  }
]

interface Project {
  title: string;
  role: string;
  tags?: string[];
  description?: string;
  href?: string;
}

const projects: Project[] = [
  {
    title: "Discord Automation Bot",
    role: "2024 - Developer & Maintainer",
    tags: ["Java", "Discord Developer Portal"]
  }
]

interface Certification {
  title: string;
  issuer: string;
  date?: string;
  credentialUrl?: string;
}

const certifications: Certification[] = []
---
<AppLayout>
  <div class="flex flex-col md:flex-row gap-xl">

    <!-- Page Body -->
    <div class="flex flex-col gap-6 px-xl py-24">

      <!-- Hero Section -->
      <section>
      <header class="flex flex-col items-center gap-4">
        <div class="flex flex-col gap-2 items-center">
          <h1 class="text-6xl font-bold">Hey! I'm Octavian Mironescu</h1>
          <h2 class="text-2xl text-gray">I'm a Java & Web Software Developer.</h2>
        </div>
        <div class="flex flex-row justify-center items-center gap-8">
          <a class="text-3xl" href="/contact/">
            <p class="text-2xl font-bold bg-green-600 rounded-md p-2">Hire me</p>
          </a>
          <a class="i-mdi-github text-4xl" href="https://github.com/MironescuOctavian"/>
        </div>
      </header>
    </section>

      <!-- Skill Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Skills</h2>
          <hr class="border-t w-full" />
        </header>

        <div class="flex flex-row gap-4">
          {skills.map((skill) => (
            <div class="flex flex-col gap-4 text-gray">
              <div class="flex flex-row gap-4">
                <span class:list={['text-2xl text-green-600', skill.icon]} />
                <h3 class="text-md font-bold uppercase tracking-wider text-white">{skill.title}</h3>
              </div>
              <p class="text-sm">{skill.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Technologies & Tools Section -->
      <section class="flex flex-col gap-4">
        <h2 class="text-3xl font-bold text-white tracking-tight">Technologies & Tools</h2>
        <hr class="border-t w-full" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {techCategories.map((category) => (
            <div class="flex flex-col gap-4">
              <h3 class="text-md font-bold uppercase tracking-wider text-white">{category.title}</h3>
              <ul class="flex flex-col gap-3 list-none p-0 m-0">
                {category.items.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-gray">
                    <span class:list={['text-base shrink-0', item.icon]} />
                    <span class="text-sm">{item.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience Section -->
      <section class="flex flex-col gap-6">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Experience</h2>
          <hr class="border-t w-full" />
        </header>

        {experiences.map((experience) => (
          <div class="text-sm">
            <span class="text-gray">{experience.period}</span>
            <h3 class="font-bold text-md">{experience.role}</h3>
            {experience.location && <span class="text-gray">{experience.location}</span>}
            {experience.tags && experience.tags.length > 0 && (
              <ul class="flex flex-row items-center gap-2 p-x-2">
                {experience.tags.map((tag) => (
                  <li class="bg-green-900 text-green-400 p-1 rounded">{tag}</li>
                ))}
              </ul>
            )}
            <h4 class="font-bold text-gray">Summary:</h4>
            <p class="text-gray">{experience.summary}</p>
            {experience.responsibilities && experience.responsibilities.length > 0 && (
              <>
                <h4 class="font-bold text-gray">Responsibilities:</h4>
                <ul class="flex flex-col px-6 gap-2 list-disc">
                  {experience.responsibilities.map((responsibility) => (
                    <li class="text-sm text-gray">{responsibility}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))}
      </section>

      <!-- Education Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Education</h2>
          <hr class="border-t w-full" />
        </header>

        {educationList.map((education) => (
          <div class="flex flex-col text-gray text-sm">
            <span>{education.period}</span>
            <h3 class="font-bold text-md">{education.degree}</h3>
            <span>{education.institution}</span>
          </div>
        ))}
      </section>

      <!-- Projects Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Projects</h2>
          <hr class="border-t w-full" />
        </header>

        {projects.map((project) => (
          <div class="flex flex-col text-gray text-sm">
            <h3 class="text-md font-bold text-white">{project.title}</h3>
            <span>{project.role}</span>
            {project.tags && project.tags.length > 0 && (
              <ul class="flex flex-row items-center gap-2 p-x-2">
                {project.tags.map((tag) => (
                  <li class="bg-green-900 text-green-400 p-1 rounded">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>

      <!-- Certifications Section -->
      <section class="flex flex-col gap-4">
        <header class="flex flex-col gap-4">
          <h2 class="text-3xl font-bold text-white tracking-tight">Certifications</h2>
          <hr class="border-t w-full" />
        </header>

        {certifications.map((certification) => (
          <div class="flex flex-col text-gray text-sm">
            <h3 class="text-md font-bold text-white">{certification.title}</h3>
            <span>{certification.issuer}</span>
            {certification.date && <span>{certification.date}</span>}
          </div>
        ))}
      </section>
    </div>

    <!-- Left Sidebar -->
    <aside aria-label="Sidebar" class="flex flex-col gap-6 px-xl py-24 order-first md:border-r border-green-900">

      <!-- Intro Section -->
      <section aria-labelledby="resume-sidebar-name" class="flex flex-col items-center gap-4">

        <!-- Name & Profession -->
        <header class="flex flex-col gap-4 items-center">
          <img class="h-auto w-65 border border-4 border-green-900" src="https://cdn.octavianmironescu.com/images/image0.jpg" alt="Graduation Pic"/>
          <div class="flex flex-col text-center">
            <h2 id="resume-sidebar-name" class="text-3xl font-bold">Mironescu Octavian</h2>
            <span class="text-lg text-gray"> Software Developer </span>
          </div>
        </header>

        <!--Links for working-->
        <ul class="flex justify-center gap-4">
          {socialLinks.map((socialLink) => (
            <li aria-label={socialLink.ariaLabel}>
              <a href={socialLink.href} class="flex items-center justify-center">
                <span class:list={['text-2xl', socialLink.icon]}/>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- About Me Section -->
      <section aria-labelledby="resume-sidebar-about-me" class="flex flex-col gap-xs">
        <header class="flex flex-col gap-2">
          <div class="flex flex-row gap-2 items-center">
            <span class="i-mdi-account text-base"/>
            <h2 id="resume-sidebar-about-me" class="font-bold text-sm">ABOUT ME</h2>
          </div>
          <hr/>
        </header>

        <dl class="flex flex-col gap-2 text-sm">
          {aboutMeDetails.map((aboutMe) => (
            <>
              <div class="flex flex-row justify-between items-center gap-2">
                <dt class="font-bold">{aboutMe.label}</dt>
                <dd class="text-gray flex flex-row items-center gap-1.5">
                  <a href={aboutMe.href} class="flex items-center justify-center">
                    {aboutMe.icon1 && <span class={aboutMe.icon1}/>}
                    <span>{aboutMe.value}</span>
                    {aboutMe.icon2 && <span class={aboutMe.icon2}/>}
                  </a>
                </dd>
              </div>
              <hr/>
            </>
          ))}
        </dl>
      </section>

      <!-- LANAGUAGES SECTION -->
      <section aria-labelledby="resume-sidebar-languages" class = "flex flex-col gap-xs">
        <header class="flex flex-col gap-2">
          <div class="flex flex-row gap-2 items-center">
            <span class="text-gray i-mdi-translate text-base"/>
            <h4 id="resume-sidebar-languages" class="font-bold text-sm">LANGUAGES</h4>
          </div>
          <hr />
        </header>
            <dl class="flex flex-col gap-2 text-sm">
              {languagesSpoken.map((language) => (
              <div class="flex flex-row gap-2 justify-between">
                <dt class="font-bold">{language.label}</dt>
                <dd class="text-gray">{language.value}</dd>
              </div>
              <hr/>
              ))}
            </dl>
      </section>
    </aside>

  </div>
</AppLayout>

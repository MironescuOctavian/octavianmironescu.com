---
import AppLayout from '#layouts/AppLayout.astro';

// Social links configuration
interface SocialLink {
  icon: string;
  href: string;
  ariaLabel: string;
}

const socialLinks: SocialLink[] = [
  {
    icon: 'i-mdi-github',
    href: 'https://github.com/MironescuOctavian',
    ariaLabel: 'GitHub',
  },
  {
    icon: 'i-mdi-linkedin',
    href: 'https://www.linkedin.com/in/octavian-mironescu-a605b921a/',
    ariaLabel: 'LinkedIn',
  },
  {
    icon: 'i-mdi-gmail',
    href: 'mailto:omironescu@gmail.com',
    ariaLabel: 'Gmail',
  },
];

// Tech stack icon list
const techStackIcons: string[] = [
  'i-logos-java',
  'i-logos-spring-icon',
  'i-logos-typescript-icon',
  'i-logos-vue',
  'i-logos-solidjs-icon',
  'i-logos-unocss',
  'i-logos-intellij-idea',
  'i-logos-visual-studio-code',
  'i-logos-webstorm',
  'i-logos-gradle',
  'i-logos-vite',
  'i-logos-pnpm',
  'i-logos-docker-icon',
  'i-logos-cloudflare-icon',
];

// "What I do" accordion items data
interface ServiceItem {
  icon: string;
  title: string;
  isOpen?: boolean;
  points: string[];
}

const services: ServiceItem[] = [
  {
    icon: 'i-mdi-web',
    title: 'Web Development',
    isOpen: true,
    points: [
      'Single Page Applications (SPAs)',
      'Landing pages and business websites',
      'Portfolio websites',
    ],
  },
  {
    icon: 'i-mdi-code-braces',
    title: 'Software Development',
    points: [
      'REST APIs and backend services',
      'CLI tools and automation scripts',
      'System design and architecture',
    ],
  },
  {
    icon: 'i-mdi-cloud-outline',
    title: 'DevOps & Cloud Infrastructure',
    points: [
      'Containerization & deployment with Docker',
      'Cloud hosting & edge deployment (Cloudflare)',
      'CI/CD pipelines & build automation',
    ],
  },
];

// Portfolio project showcases for "My Work" section
interface Project {
  title: string;
  status: string;
  image: string;
  githubUrl?: string;
  previewUrl?: string;
}

const projects: Project[] = [
  {
    title: 'octavianmironescu.com',
    status: 'Deployed',
    image: 'https://placehold.co/600x400/101010/16a34a?text=Portfolio+Website',
    githubUrl: 'https://github.com/MironescuOctavian/octavianmironescu.com',
    previewUrl: 'https://octavianmironescu.com',
  },
  {
    title: 'Backend API Service',
    status: 'In Development',
    image: 'https://placehold.co/600x400/101010/16a34a?text=Backend+Services',
    githubUrl: 'https://github.com/MironescuOctavian',
    previewUrl: 'https://github.com/MironescuOctavian',
  },
  {
    title: 'Full-stack Platform',
    status: 'Contributor',
    image: 'https://placehold.co/600x400/101010/16a34a?text=Full-stack+App',
    githubUrl: 'https://github.com/MironescuOctavian',
    previewUrl: 'https://github.com/MironescuOctavian',
  },
  {
    title: 'Developer Automation Tools',
    status: 'Deployed',
    image: 'https://placehold.co/600x400/101010/16a34a?text=Automation+Tools',
    githubUrl: 'https://github.com/MironescuOctavian',
    previewUrl: 'https://github.com/MironescuOctavian',
  },
];

const inputClass =
  'px-4 py-3 bg-black/40 text-white border border-green-900 rounded-xl focus:outline-none focus:border-green-500 transition-colors';
const projectBtnClass =
  'flex items-center justify-center p-3 rounded-xl border border-green-900 bg-black/60 text-gray-300 hover:text-white hover:border-green-600 transition-colors';
---

<AppLayout>
  <div class="w-full">
    <!-- Hero Section -->
    <section class="flex flex-col p-12 w-full">
      <p class="text-2xl">Hi, I'm Mironescu Octavian</p>
      <header class="flex md:flex-row flex-col justify-start items-center gap-6 mt-2">
        <h1 class="text-white font-bold text-6xl">Software Developer</h1>
        <p class="text-3xl">
          Transforming ideas into interactive and seamless digital experiences with cutting-edge <span class="text-green-600">frontend</span> and <span class="text-green-600">backend</span> development.
        </p>
      </header>

      <!-- Social Media Badges -->
      <ul class="flex gap-4 py-8 justify-start">
        {socialLinks.map((link) => (
          <li aria-label={link.ariaLabel}>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center border-2 rounded-2xl border-green-900 p-2 hover:border-green-600 transition-colors"
            >
              <span class:list={['text-5xl', link.icon]} />
            </a>
          </li>
        ))}
      </ul>

      <!-- Tech Stack Icons Showcase -->
      <ul class="flex flex-wrap gap-6 items-center justify-start">
        {techStackIcons.map((icon) => (
          <li class="flex items-center justify-center w-10 h-10 py-6">
            <span class:list={['w-10 h-10 text-4xl', icon]} />
          </li>
        ))}
      </ul>
    </section>

    <!-- What I Do Section -->
    <section class="flex flex-col lg:flex-row items-center gap-8 w-full px-12 py-8">
      <!-- Left: Service Accordions -->
      <div class="flex flex-col gap-4 w-full lg:w-1/2 min-w-0">
        <h2 class="text-4xl font-bold text-white mb-2">What I do?</h2>

        <div class="flex flex-col gap-4">
          {services.map((service) => (
            <details class="border border-green-900 rounded-xl overflow-hidden bg-black/20" open={service.isOpen}>
              <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer list-none select-none hover:bg-green-950/20 transition-colors">
                <span class:list={['w-6 h-6 text-green-500 inline-block shrink-0', service.icon]} />
                <span class="text-white text-lg font-medium flex-1">{service.title}</span>
                <span class="i-mdi-chevron-down w-5 h-5 text-white inline-block accordion-chevron" />
              </summary>
              <ul class="flex flex-col gap-2 px-6 pb-5 text-gray-300 text-sm">
                {service.points.map((point) => (
                  <li class="flex items-center gap-2">
                    <span class="text-green-500">·</span> {point}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </div>

      <!-- Right: GitHub Activity Card (replacing matrix canvas position) -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center min-w-0">
        <div class="flex items-baseline justify-between mb-4">
          <h3 class="text-2xl font-bold text-white flex items-center gap-2">
            <span class="i-mdi-github w-6 h-6 text-green-500 inline-block" />
            GitHub Activity
          </h3>
          <a
            href="https://github.com/MironescuOctavian"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-gray-400 hover:text-green-400 transition-colors flex items-center gap-1"
          >
            @MironescuOctavian
            <span class="i-mdi-arrow-top-right w-4 h-4 inline-block" />
          </a>
        </div>

        <!-- Activity Heatmap Container -->
        <div class="border border-green-900 rounded-2xl p-5 bg-black/20 flex flex-col items-center justify-center overflow-hidden">
          <div class="w-full overflow-x-auto pb-1">
            <img
              src="https://ghchart.rshah.org/16a34a/MironescuOctavian"
              alt="MironescuOctavian GitHub contribution calendar"
              class="w-full min-w-[580px] h-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-12 px-12 border-t border-green-900/60 text-white">
      <h2 class="text-lg text-green-500 font-medium mb-1">My work</h2>
      <h3 class="text-4xl md:text-5xl font-bold mb-8">Projects</h3>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <div class="group border border-green-900/80 hover:border-green-600/80 rounded-2xl overflow-hidden bg-black/30 transition-all duration-300">
            <a href={project.previewUrl || project.githubUrl || '#'} target="_blank" rel="noopener noreferrer" class="block overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
            <div class="flex items-center justify-between p-5">
              <div>
                <h4 class="text-xl font-semibold text-white">{project.title}</h4>
                <span class="inline-block mt-1 text-xs px-2.5 py-1 rounded-full border border-green-800 text-green-400 bg-green-950/40">
                  {project.status}
                </span>
              </div>
              <div class="flex gap-2">
                {project.githubUrl && (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository" class={projectBtnClass}>
                    <span class="i-mdi-code-tags text-xl" />
                  </a>
                )}
                {project.previewUrl && (
                  <a href={project.previewUrl} target="_blank" rel="noopener noreferrer" aria-label="Live Preview" class={projectBtnClass}>
                    <span class="i-mdi-arrow-top-right text-xl" />
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- More Projects Link -->
      <a
        href="https://github.com/MironescuOctavian?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 mt-10 text-gray-300 hover:text-white border border-green-900 hover:border-green-600 p-3.5 rounded-full bg-black/40 hover:bg-green-950/20 hover:scale-[1.01] transition-all"
      >
        <span class="text-base font-medium">More projects on GitHub</span>
        <span class="i-mdi-github text-xl text-green-500" />
      </a>
    </section>

    <!-- Contact Section  -->
    <section id="contact" class="w-full py-12 px-12 border-t border-green-900/60 text-white">
      <div class="w-full">
        <h2 class="text-lg text-green-500 font-medium mb-1">Let's talk</h2>
        <h3 class="text-4xl md:text-5xl font-bold mb-6">Contact</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Contact Info -->
          <div class="flex flex-col justify-start text-gray-300 space-y-4">
            <p class="text-lg leading-relaxed">
              Have a question, feedback, or a project in mind? Feel free to reach out directly through the form or via email.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <span class="i-mdi-email-outline text-green-500 text-xl" />
              <a href="mailto:omironescu@gmail.com" class="hover:text-green-400 transition-colors">
                omironescu@gmail.com
              </a>
            </div>
            <div class="flex items-center gap-3">
              <span class="i-mdi-map-marker-outline text-green-500 text-xl" />
              <span class="text-white">Romania</span>
            </div>
          </div>

          <!-- Contact Form -->
          <form action="https://formspree.io/f/YOUR_FORM_ID_HERE" method="POST" class="flex flex-col gap-4">
            <label for="name">Name
              <input type="text" name="name" placeholder="Name" required class={inputClass} />
            </label>
            <label for="email">Email
              <input type="email" name="email" placeholder="Email" required class={inputClass} />
            </label>
            <label for="message">Message
              <textarea name="message" placeholder="Message" rows="5" required class:list={[inputClass, 'resize-none']}></textarea>
            </label>
            <button type="submit" class="px-6 py-3 bg-green-950/60 border border-green-700 hover:border-green-500 text-white font-medium rounded-xl hover:bg-green-900/60 transition-colors cursor-pointer">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  /* Rotate chevron when details is open */
  .accordion-chevron {
    transition: transform 0.2s ease;
  }
  details[open] > summary .accordion-chevron {
    transform: rotate(180deg);
  }
</style>

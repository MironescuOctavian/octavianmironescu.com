---
import AppLayout from "#layouts/AppLayout.astro";
import AppError from "#components/app/AppError.astro";

interface Props {
	error?: unknown;
}

const { error } = Astro.props;

Astro.response.status = 500;
Astro.response.statusText = "Internal Server Error";
---

<AppLayout title="500 - Server Error" description="An error occurred">
	<AppError
		code={500}
		title="Internal Server Error"
		description={error instanceof Error ? error.message : "An unexpected error occurred on the server."}
		actions={[
			{ label: "Go to Home Page", href: "/", variant: "solid", color: "primary", icon: "i-lucide-home" }
		]}
	/>
</AppLayout>
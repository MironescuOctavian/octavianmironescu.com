---
import { SITE_DESCRIPTION, SITE_TITLE } from "#consts.ts";
import BaseHead from "#components/BaseHead.astro";
import Header from "#components/Header.astro";
import Footer from "#components/Footer.astro";
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro";
import RLAScrollToTop from "@rimelight/ui/components/scroll-to-top/RLAScrollToTop.astro";
import { getHtmlLang, currentLocale } from "@rimelight/i18n";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const locale = Astro.params["locale"];
if (locale) {
  currentLocale.set(locale);
}
---
<!doctype html>
<html lang={getHtmlLang()}>
<head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
</head>
<body class="isolate">
<Header />
<RLAMain>
    <slot />
</RLAMain>
<Footer />
<RLAScrollToTop showProgress={true} />
</body>
</html>